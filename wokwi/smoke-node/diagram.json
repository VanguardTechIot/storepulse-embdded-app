{
  "version": 1,
  "author": "VanguardTech",
  "editor": "wokwi",
  "parts": [
    { "type": "wokwi-esp32-devkit-v1", "id": "esp", "top": 0, "left": 0, "attrs": {} },
    { "type": "wokwi-gas-sensor", "id": "mq2", "top": -150, "left": -230, "attrs": { "ppm": "100" } },
    { "type": "wokwi-dht22", "id": "dht", "top": -130, "left": 230, "attrs": { "temperature": "24", "humidity": "55" } },
    { "type": "wokwi-resistor", "id": "r1", "top": 140, "left": 200, "rotate": 90, "attrs": { "value": "220" } },
    { "type": "wokwi-led", "id": "led", "top": 200, "left": 250, "attrs": { "color": "red", "label": "ALERT" } }
  ],
  "connections": [
    [ "esp:TX0", "$serialMonitor:RX", "", [] ],
    [ "esp:RX0", "$serialMonitor:TX", "", [] ],
    [ "mq2:VCC", "esp:3V3", "red", [] ],
    [ "mq2:GND", "esp:GND.2", "black", [] ],
    [ "mq2:AOUT", "esp:D34", "orange", [] ],
    [ "dht:VCC", "esp:3V3", "red", [] ],
    [ "dht:GND", "esp:GND.1", "black", [] ],
    [ "dht:SDA", "esp:D15", "green", [] ],
    [ "esp:D2", "r1:1", "blue", [] ],
    [ "r1:2", "led:A", "blue", [] ],
    [ "led:C", "esp:GND.1", "black", [] ]
  ],
  "dependencies": {}
}
